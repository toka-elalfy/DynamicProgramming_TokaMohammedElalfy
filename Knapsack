def knapsack(
    weights: list[int],
    values: list[int],
    capacity: int,
) -> int:
    if len(weights) != len(values):
        raise ValueError(
            f"weights and values must have the same length "
            f"({len(weights)} != {len(values)})"
        )
    if capacity < 0:
        raise ValueError("capacity must be non-negative")
    if any(w < 0 for w in weights):
        raise ValueError("weights must be non-negative")
    if any(v < 0 for v in values):
        raise ValueError("values must be non-negative")

    n = len(weights)
    if n == 0 or capacity == 0:
        return 0

    dp: list[int] = [0] * (capacity + 1)

    for i in range(n):
        w_i = weights[i]
        v_i = values[i]

        if w_i > capacity:
            continue

        for c in range(capacity, w_i - 1, -1):
            take = dp[c - w_i] + v_i
            if take > dp[c]:
                dp[c] = take

    return dp[capacity]


if __name__ == "__main__":
    weights = [1, 3, 4, 5]
    values  = [1, 4, 5, 7]
    capacity = 7

    print(knapsack(weights, values, capacity))  

    assert knapsack([2, 3, 4], [3, 4, 5], 5) == 7          
    assert knapsack([], [], 10) == 0                        
    assert knapsack([5], [10], 4) == 0                      
    assert knapsack([1, 2, 3], [6, 10, 12], 5) == 22        
    assert knapsack([4, 5, 1], [1, 2, 3], 4) == 3           
    print("All assertions passed.")
